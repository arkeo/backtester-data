# Same job, but the code is pulled from a private repository.
#
# Use this instead of publish-history.yml if you would rather not publish the
# fetching code. Add one more secret:
#
#   SOURCE_REPO   owner/name of the private repository
#   SOURCE_TOKEN  a fine-grained personal access token with read access to it
#
# The token never leaves GitHub. This workflow has no pull_request trigger, so
# a fork cannot run it and cannot see the secret.

name: publish history (private source)

on:
  schedule:
    - cron: "0 6 * * *"
  workflow_dispatch:

concurrency:
  group: publish-history
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 330
    steps:
      - name: Get the code from the private repository
        uses: actions/checkout@v4
        with:
          repository: ${{ secrets.SOURCE_REPO }}
          token: ${{ secrets.SOURCE_TOKEN }}

      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"
      - run: pip install numpy

      - name: Restore the store
        uses: actions/cache@v4
        with:
          path: data
          key: history-${{ github.run_id }}
          restore-keys: history-

      - name: Fetch, trim, seal
        env:
          BACKTESTER_DATA: ${{ github.workspace }}/data
          BACKTESTER_KEY: ${{ secrets.BACKTESTER_KEY }}
        run: |
          YEARS="${{ vars.YEARS || '5' }}"
          FROM=$(date -u -d "$YEARS years ago" +%Y-%m-%d)
          for symbol in ${{ vars.SYMBOLS || 'EURUSD XAUUSD US30' }}; do
            python -m app.fetch "$symbol" --from "$FROM" || echo "::warning::$symbol did not complete"
          done
          python -m app.trim all --years "$YEARS"
          python -m app.portable publish all --to mirror

      - name: Replace the release assets
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh release view history >/dev/null 2>&1 \
            || gh release create history --title "Market history" --notes "Updated automatically."
          gh release upload history mirror/* --clobber
